# ---------- Database ----------
# Lokalnie: Postgres na maszynie / `pnpm exec prisma dev` / Docker.
# Produkcja: Neon connection string (pooled, z `?sslmode=require&pgbouncer=true`).
DATABASE_URL="postgresql://user:password@localhost:5432/coursed?schema=public"

# Neon: direct (unpooled) URL — używany przez `prisma migrate deploy`.
# Bez tego migracje przez pgbouncer w trybie transaction mogą się wywalić.
# Lokalnie zostaw pusty (Prisma użyje DATABASE_URL).
DIRECT_URL=""

# ---------- Auth.js v5 ----------
# Wygeneruj: `pnpm dlx auth secret`
AUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (https://resend.com) — magic link email
AUTH_RESEND_KEY=""
EMAIL_FROM="coursed.pl <noreply@coursed.pl>"

# Publiczny URL — używany przez Auth.js, sitemap, robots, metadataBase, OG.
# Lokalnie: zostaw zakomentowane (domyślnie http://localhost:3000).
# Produkcja: ustaw na https://coursed.pl (bez slash na końcu).
# AUTH_URL="http://localhost:3000"

# ---------- Upstash Redis (rate-limit) ----------
# Opcjonalne — bez tych zmiennych rate-limit działa in-memory (ok. dla deva,
# nieskuteczne przy multi-instance prod). Konto: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
