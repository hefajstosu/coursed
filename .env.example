# ---------- Database ----------
# Lokalnie: Postgres na maszynie / `pnpm exec prisma dev` / Docker.
# Produkcja: Neon connection string (z pulingiem).
DATABASE_URL="postgresql://user:password@localhost:5432/coursed?schema=public"

# ---------- Auth.js v5 ----------
# Wygeneruj: `pnpm dlx auth secret`
AUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (https://resend.com) — magic link email
AUTH_RESEND_KEY=""
EMAIL_FROM="coursed.pl <noreply@coursed.pl>"

# Opcjonalne — używane przez Auth.js przy deploymencie za reverse proxy.
# AUTH_URL="http://localhost:3000"

# ---------- Vercel Blob (okładki kursów) ----------
# Pobierz z dashboardu Vercel po utworzeniu Blob storage.
BLOB_READ_WRITE_TOKEN=""
